{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonda",
  "version": "0.1.0",
  "identifier": "com.cxalem.scainner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sonda",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/cxalem/scainner/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5OUZERUU5MzUxQTQzNkUKUldSdVF4bzE2ZDZmNllSMU4rNTlDUFMzaDNTYXVyZllqVThtbzR1MksyelJYNkRsUW11RG12TlgK"
    }
  }
}