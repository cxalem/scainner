{
  "schema_version": 1,
  "brand_ids": [
    "psa"
  ],
  "central_policy_relationship": "Brand pack may only reduce central limits.",
  "automatic_discovery": {
    "read_only": true,
    "default_session_only": true,
    "max_outstanding_requests": 1,
    "passive_capture": "attempt only if adapter reliably monitors active pins/protocol; otherwise passive_capture_unavailable"
  },
  "never_automatic_services": [
    "10_non_default",
    "11",
    "14",
    "27",
    "28",
    "2E",
    "2F",
    "31",
    "34",
    "35",
    "36",
    "37",
    "3D"
  ],
  "brand_budget_reductions": {
    "S0_standard_handshake_seconds": 30,
    "S1_census_plus_S2_identity_seconds": 150,
    "S4_bounded_parked_sweep_seconds": 180,
    "whole_automatic_connection_seconds": 480,
    "learning_drive_max_link_occupancy_percent": 15,
    "candidate_caps": {
      "exact_route_presence_candidates_per_replan": 64,
      "identity_reads_per_reached_ecu": 7,
      "initial_candidate_dids_per_reached_route": 24
    }
  },
  "generic_enumeration": {
    "can11": {
      "authorized_after_transport_confirmation": true,
      "from": "700",
      "to": "7F6",
      "exclude": [
        "7DF"
      ]
    },
    "can29": {
      "authorized": false,
      "reason": "No sufficiently normalized PSA-wide 29-bit enumeration grammar in this pack."
    }
  },
  "session_policy": {
    "product": "default_only",
    "extended_session": "Lab only with exact route+DID+fingerprint+immutable source+stationary state+cleanup to default",
    "security_access_after_extended_session": false
  },
  "psa_tooling_restriction": {
    "pypsadiag_write_zone": false,
    "pypsadiag_clear_dtcs": false,
    "pypsadiag_flash": false,
    "pypsadiag_routines": false,
    "pypsadiag_key_bruteforce": false,
    "note": "These capabilities exist in the source tool but are not discovery candidates."
  },
  "nrc_policy": {
    "78": "bounded wait without resend",
    "security_related": "terminate path",
    "all_nrcs": "persist observations; a refusal may establish route reachability"
  },
  "abort_conditions": [
    "user_cancel",
    "unsafe_adapter_state",
    "bus_health_failure"
  ]
}
